# Neon Postgres connection string (pooled / serverless OK)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth.js session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Public site URL (required for correct Auth.js callbacks on Vercel)
AUTH_URL=https://virilion-staging.vercel.app
